generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id
  email        String    @unique
  passwordHash String
  displayName  String
  createdAt    DateTime  @default(now())
  events       Event[]
  rsvps        Rsvp[]
  comments     Comment[]
  sessions     Session[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Event {
  id              String    @id
  authorId        String
  author          User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title           String
  titleNormalized String
  description     String
  startsAt        DateTime
  capacity        Int
  coverFilename   String?
  isPublic        Boolean
  inviteToken     String    @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  rsvps           Rsvp[]
  comments        Comment[]

  @@index([isPublic, startsAt])
  @@index([authorId])
  @@index([titleNormalized])
}

model Rsvp {
  id        String   @id
  eventId   String
  userId    String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId])
}

model Comment {
  id        String   @id
  eventId   String
  userId    String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
}
