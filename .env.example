# SQLite. Path is relative to the prisma/ directory.
DATABASE_URL="file:../data/tusovka.db"

# Set to "true" when serving over HTTPS so the session cookie gets Secure.
# In production (NODE_ENV=production) Secure is on by default.
SESSION_COOKIE_SECURE="false"

# Public origin of this app (used in invite links and Origin checks).
# Example: http://localhost:3000
APP_ORIGIN="http://localhost:3000"
